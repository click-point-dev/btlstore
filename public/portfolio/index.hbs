<!doctype html>
<html lang="ru">

   <head>
      {{> app/head canonical='https://probtl.ru/portfolio/' title='Агентство событий “ПРОБТЛ”. Наше портфолио в сфере BTL, Event и PR' description='Нам доверяют организацию мероприятий известные федеральные бренды и региональные компании. Корпоративы. Бизнес-события. Праздники. Реализация промоакций в городах РФ.' ogImage='https://probtl.ru/images/main-page/01.webp'}}
   </head>

   <body>
      <div class="page page__portfolio wrapper">
         {{> app/loader/loader}}

         {{> widgets/header/header}}

         <main class="portfolio-page">

            <section class="portfolio pb-200">
               <div class="portfolio__container" data-portfolio>
                  {{!--- portfolioPage() placeholder for casesCards ---}}
               </div>
            </section>
         </main>
         {{> widgets/footer/footer}}
         {{#> widgets/popup/popup type='request-popup'}}
         <div class="main__full-width-form full-width-form">
            <div class="full-width-form__container">
               <div class="full-width-form__head">
                  <div class="full-width-form__title">
                     <h5 class="h5 text-white">Закажите услугу</h5>
                  </div>
                  <div class="full-width-form__sub-title">
                     <p class="text-s text-white">
                        Планируете организовать корпоратив, тимбилдинг,
                        мероприятие для клиентов?
                     </p>
                  </div>
               </div>
               <div class="full-width-form__body">
                  <form class="full-width-form__form form" method="post">
                     <div class="form__loader">
                        <img src="/images/SvgSpinnersBlocksScale.svg" alt="" />
                     </div>
                     <div class="form__row">
                        <div class="input-block text-white">
                           <input class="input" name="name" id="name" type="text" placeholder="" />
                           <label for="name">Имя</label>
                           <input class="input fn" name="fn" id="fn" type="text" required />
                        </div>
                        <div class="input-block text-white">
                           <input class="input" name="city" id="city" type="text" placeholder="" />
                           <label for="city">Город</label>
                        </div>
                        <div class="input-block text-white">
                           <input class="input" name="phone" id="phone" type="tel" placeholder="" required />
                           <label for="phone">Телефон</label>
                        </div>
                     </div>
                     <div class="form__row">
                        <div class="input-block text-white">
                           <textarea class="input" name="comment" id="message" rows="1"></textarea>
                           <label for="message">Опишите, что вам требуется организовать</label>
                        </div>
                     </div>
                     <div class="form__row">
                        <div class="button button-light button-xl">
                           <button type="submit" class="" id="submit-btn">
                              Оставить заявку
                           </button>
                        </div>
                        <div class="checkbox text-xxs text-white text-white" data-checkbox>
                           <label class="">
                              <input type="checkbox" name="agreement" />
                              <i></i>
                              <span>я принимаю условия
                                 <a class="text-underline" href="/privacy" target="blank">Политики конфиденциальности</a>, и даю согласие на обработку персональных
                                 данных</span>
                           </label>
                        </div>
                     </div>
                  </form>
               </div>
            </div>
         </div>
         {{/widgets/popup/popup}}
      </div>
   </body>
</html>
