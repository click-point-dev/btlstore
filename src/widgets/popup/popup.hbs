<div class="popup" data-popup-type='{{type}}'>
	<div class='popup__wrapper {{#if wrapperClasses}}{{wrapperClasses}}{{/if}}'>
		<div class="popup__close ">
			<span class='icon-close {{#if closeClasses}}{{closeClasses}}{{/if}}'></span>
		</div>
		<div class="popup__block">
			{{#if container}}
			<div class="popup__container">
				{{> @partial-block}}
			</div>
			{{else}}
			{{> @partial-block}}
			{{/if}}
		</div>
	</div>
</div>

